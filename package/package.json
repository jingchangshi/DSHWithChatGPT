{
  "name": "dsh-with-chatgpt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "description": "PlannerBridge for DeepSeek Harness: ChatGPT Web plans and reviews over a read-only workspace data plane; DSH owns execution.",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": { "chat-control-sidecar": "lib/deployment/sidecar-process-entry.js" },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol/index.d.ts",
      "default": "./lib/protocol/index.js"
    },
    "./workspace": {
      "types": "./lib/workspace/index.d.ts",
      "default": "./lib/workspace/index.js"
    },
    "./browser": {
      "types": "./lib/browser/index.d.ts",
      "default": "./lib/browser/index.js"
    },
    "./sidecar": {
      "types": "./lib/sidecar/index.d.ts",
      "default": "./lib/sidecar/index.js"
    },
    "./sidecar/server": {
      "types": "./lib/sidecar/server.d.ts",
      "default": "./lib/sidecar/server.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:package": "node scripts/verify-package.mjs",
    "test:profile": "node scripts/verify-profile.mjs",
    "test:profile-sidecar-fixture": "node --test scripts/profile-sidecar-fixture.test.mjs",
    "test:planner-executor-e2e": "node scripts/verify-planner-executor-e2e.mjs",
    "test:planner-executor-observer": "node --test scripts/planner-executor-observer.test.mjs",
    "test:legacy-acceptance-entry": "node --test scripts/legacy-acceptance-entry.test.mjs",
    "test:live-c2c-observer": "node --test scripts/c2c-e2e-observer.test.mjs",
    "test:live-c2c": "node scripts/verify-live-c2c.mjs",
    "test:launcher": "node --test scripts/c2c-launcher.test.mjs",
    "test:plannerbridge-deployment": "node scripts/plannerbridge-deployment.test.mjs",
    "test:product-c2c": "node scripts/dsh-product-c2c.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-execution-world": ">=0.1.6-alpha.4",
    "@deepseek-ai/dsh-fs": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-sandbox": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess": ">=0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-execution-world": "file:tarballs/deepseek-ai-dsh-execution-world-0.1.6-alpha.4.tgz",
    "@deepseek-ai/dsh-fs": "file:tarballs/deepseek-ai-dsh-fs-0.1.6-alpha.2.tgz",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "file:tarballs/deepseek-ai-dsh-storage-domain-0.1.6-alpha.2.tgz",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "happy-dom": "20.11.6",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-llm": "file:tarballs/deepseek-ai-dsh-llm-0.1.6-alpha.2.tgz",
      "@deepseek-ai/dsh-attachment": "file:tarballs/deepseek-ai-dsh-attachment-0.1.6-alpha.2.tgz",
      "@deepseek-ai/dsh-fs": "file:tarballs/deepseek-ai-dsh-fs-0.1.6-alpha.2.tgz",
      "@deepseek-ai/dsh-execution-world-affinity": "file:tarballs/deepseek-ai-dsh-execution-world-affinity-0.1.6-alpha.2.tgz"
    }
  }
}
