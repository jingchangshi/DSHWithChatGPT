{
  "name": "dsh-with-chatgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: ChatGPT Web plans and reviews over a read-only MCP data plane; DSH/GLM owns execution.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol/index.d.ts",
      "default": "./lib/protocol/index.js"
    },
    "./workspace": {
      "types": "./lib/types/workspace/index.d.ts",
      "default": "./lib/workspace/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "d2c": "./lib/cli.js"
  },
  "files": [
    "lib/index.js",
    "lib/cli.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-storage-domain": "file:tarballs/deepseek-ai-dsh-storage-domain-0.1.6-alpha.1.tgz",
    "@types/node": "^24.0.0",
    "deepseek-harness-check": "link:../deepseek-harness-check",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
